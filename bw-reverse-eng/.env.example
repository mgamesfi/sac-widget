# Copie para .env e preencha. NUNCA comitar o .env real (ver .gitignore).

# --- Conexão HANA (RF01) ---
HANA_HOST=hana.cliente.exemplo.com
HANA_PORT=30015
HANA_USER=BWREVENG_TECH
HANA_PASSWORD=
# Alternativa a usuário/senha: autenticação por certificado de cliente
HANA_CLIENT_CERT=
HANA_CLIENT_KEY=
HANA_ENCRYPT=true
HANA_VALIDATE_CERT=true
HANA_CONNECT_TIMEOUT_S=30

# --- Conexão RFC complementar (seção 3.3) — só necessária para --with-rfc-rules /
# test-connection --rfc; extrai a lógica de negócio das regras de transformação.
# Exige o pacote `pyrfc` + SAP NW RFC SDK instalados (não vem via pip comum).
RFC_ASHOST=bw-app.cliente.exemplo.com
RFC_SYSNR=00
RFC_CLIENT=100
RFC_USER=BWREVENG_CPIC
RFC_PASSWORD=
RFC_LANG=EN
# RFC_ROUTER=/H/saprouter.cliente.exemplo.com/S/3299
# Não há BAPI padrão universal para isto — normalmente uma função Z-customizada
# que o time ABAP do cliente precisa implementar e disponibilizar via RFC.
RFC_RULES_FUNCTION_MODULE=Z_BWREVENG_GET_TRFN_RULES
RFC_FETCH_ROUTINE_SOURCE=false

# --- Configurações gerais da aplicação ---
BWREVENG_DEFAULT_LANGUAGE=EN
BWREVENG_DEFAULT_OUTPUT_DIR=./data
BWREVENG_LOG_LEVEL=INFO
BWREVENG_COMPOSITE_PROVIDER_SOURCE_THRESHOLD=5
BWREVENG_TRANSFORMATION_RULE_THRESHOLD=10
